# Kopiraj u .env i izmeni po potrebi (.env se ne commituje).

# Ollama: na računaru domaćinu (podrazumevano) ili u kontejneru (--profile ollama, tada http://ollama:11434).
OLLAMA_BASE_URL=http://host.docker.internal:11434
CHAT_MODEL=gemma4:e4b
EMBEDDING_MODEL=embeddinggemma

# Baza (lozinka je lokalna, baza je dostupna samo sa ovog računara)
POSTGRES_PASSWORD=aitutor
DB_PORT=5433

# Web interfejs: http://localhost:8080
WEB_PORT=8080

# Predmet koji se bira na početku
DEFAULT_SUBJECT=Programski prevodioci

# Folder sa materijalom za ingest (podfolderi su tipovi izvora: predavanja, vezbe, pismeni, usmeni, reseni_blanketi, obrasci)
MATERIALS_DIR=./data
